#!/usr/bin/env php
<?php
declare(strict_types=1);
$autoload=null;
foreach([$_composer_autoload_path??null,dirname(__DIR__).'/vendor/autoload.php',dirname(__DIR__,3).'/autoload.php']as$candidate){if(is_string($candidate)&&is_file($candidate)){$autoload=$candidate;break;}}
if($autoload===null){fwrite(STDERR,"Dependencies are not installed. Run composer install.\n");exit(70);}
require $autoload;
$cwd=getcwd();if(!is_string($cwd)){fwrite(STDERR,"Unable to resolve current directory.\n");exit(70);}
exit((new voku\AgentLoopRunner\Application\RunnerApplication($cwd))->run(array_slice($argv,1)));
