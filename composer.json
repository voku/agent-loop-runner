{
  "name": "voku/agent-loop-runner",
  "description": "Optional execution plane for voku/agent-loop: host adapters, isolated workspaces, process supervision, and restart-safe governed execution.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/voku/agent-loop-runner",
  "require": {
    "php": "^8.3",
    "voku/agent-loop": "dev-main"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "voku\\AgentLoopRunner\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "voku\\AgentLoopRunner\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/agent-loop-runner"
  ],
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
    "ci": [
      "@composer validate --strict",
      "@test",
      "@phpstan"
    ]
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
